# --- Postgres (matches docker-compose.yml) ------------------------------------
DATABASE_URL=postgresql://multirag:multirag@localhost:5432/multirag

# --- Anthropic (chat + tool_use) ---------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# --- Embeddings ---------------------------------------------------------------
# Provider choice. One of: sentence_transformers | openai | voyage
# sentence_transformers: local model via HuggingFace. First run downloads
#   ~1.3 GB for bge-large. No API key needed. Runs on CPU by default, will
#   auto-use CUDA if available.
# openai: text-embedding-3-large @ configurable dimensions. Needs OPENAI_API_KEY.
# voyage: voyage-3 @ 1024 dims. Needs VOYAGE_API_KEY.
EMBED_PROVIDER=sentence_transformers
EMBED_MODEL=BAAI/bge-large-en-v1.5
EMBED_DIMENSIONS=1024
# BGE-family models want a query prefix but NOT a document prefix. Leave blank
# for models that don't need them (e.g. e5-* wants "query: " and "passage: ").
EMBED_QUERY_PREFIX=Represent this sentence for searching relevant passages:
EMBED_DOC_PREFIX=
# Only needed if EMBED_PROVIDER is set to that provider:
OPENAI_API_KEY=
VOYAGE_API_KEY=

# --- Pinecone ----------------------------------------------------------------
PINECONE_API_KEY=pcsk-...
PINECONE_INDEX=multirag-docs
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# --- App ---------------------------------------------------------------------
APP_ENV=dev
LOG_LEVEL=INFO
CHUNK_SIZE=800
CHUNK_OVERLAP=100
DOCS_STAGING_DIR=./docs
