# --- Postgres (matches docker-compose.yml) ------------------------------------
DATABASE_URL=postgresql://multirag:multirag@localhost:5434/multirag

# --- Anthropic (chat + tool_use) ---------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# --- Embeddings ---------------------------------------------------------------
# Provider choice. One of: openai | voyage | sentence_transformers
# openai (default): text-embedding-3-large truncated to 1024 dims. Needs OPENAI_API_KEY.
# voyage:           voyage-3 @ 1024 dims. Needs VOYAGE_API_KEY.
# sentence_transformers: local HuggingFace model (bge-large-en-v1.5). Only
#   works if you installed the optional `local` extra: pip install -e ".[local]"
EMBED_PROVIDER=openai
EMBED_MODEL=text-embedding-3-large
EMBED_DIMENSIONS=1024
# Sentence-transformers only. BGE wants a query prefix; leave blank for models
# that don't need one. Ignored by openai / voyage.
EMBED_QUERY_PREFIX=Represent this sentence for searching relevant passages:
EMBED_DOC_PREFIX=
OPENAI_API_KEY=sk-...
VOYAGE_API_KEY=

# --- Pinecone ----------------------------------------------------------------
PINECONE_API_KEY=pcsk-...
PINECONE_INDEX=multirag-docs
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# --- App ---------------------------------------------------------------------
APP_ENV=dev
LOG_LEVEL=INFO
CHUNK_SIZE=800
CHUNK_OVERLAP=100
DOCS_STAGING_DIR=./docs
