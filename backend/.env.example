# --- Postgres (matches docker-compose.yml) ------------------------------------
DATABASE_URL=postgresql://multirag:multirag@localhost:5434/multirag
https://console.neon.tech/app/projects/lingering-meadow-50667852/branches/br-fragrant-math-apxgc5gu/tables
# --- Anthropic (chat + tool_use) ---------------------------------------------
ANTHROPIC_API_KEY=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
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# --- Embeddings ---------------------------------------------------------------
# Provider choice. One of: openai | voyage | sentence_transformers
# openai (default): text-embedding-3-large truncated to 1024 dims. Needs OPENAI_API_KEY.
# voyage:           voyage-3 @ 1024 dims. Needs VOYAGE_API_KEY.
# sentence_transformers: local HuggingFace model (bge-large-en-v1.5). Only
#   works if you installed the optional `local` extra: pip install -e ".[local]"
EMBED_PROVIDER=openai
EMBED_MODEL=text-embedding-3-large
EMBED_DIMENSIONS=1024
# Sentence-transformers only. BGE wants a query prefix; leave blank for models
# that don't need one. Ignored by openai / voyage.
EMBED_QUERY_PREFIX=Represent this sentence for searching relevant passages:
EMBED_DOC_PREFIX=
OPENAI_API_KEY=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
VOYAGE_API_KEY=

# --- Pinecone ----------------------------------------------------------------
PINECONE_API_KEY=pcsk_4sCZ6r_HA6szrELS2YZLrFA3dnCtmJFDQDW9c2RBp2NEXCdAT6NPfmHyQSnQNy1gDDfPjj
PINECONE_INDEX=multirag-docs
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# --- App ---------------------------------------------------------------------
APP_ENV=dev
LOG_LEVEL=INFO
CHUNK_SIZE=800
CHUNK_OVERLAP=100
DOCS_STAGING_DIR=./docs

# --- Memory ------------------------------------------------------------------
# Every memory row (conversation, fact, episode) is scoped by user_id. The demo
# uses a hard-coded value; switch to a per-request value once auth is in place.
MEMORY_USER_ID=local
# Fire-and-forget rolling summary of long conversations after each turn. Off by
# default to keep the Anthropic bill predictable in dev.
MEMORY_AUTO_SUMMARIZE=false
# How many facts to inject into the system prompt per turn.
MEMORY_RECALL_TOP_K=5
