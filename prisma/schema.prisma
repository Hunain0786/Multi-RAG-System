// Prisma schema for the multi-rag e-commerce demo.
// Postgres is source of truth for the SQL semantic layer AND for the Doc registry
// (list-of-what-has-been-ingested). Chunk vectors themselves live in Pinecone.
//
// Apply with:  npx prisma db push --schema prisma/schema.prisma
//
// snake_case in the DB, camelCase on the Prisma client. Python reads via psycopg
// so only DB-side names matter.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// E-commerce operational tables (fact tables for the semantic layer)
// ============================================================================

model Customer {
  id         String   @id @default(cuid())
  email      String   @unique
  firstName  String   @map("first_name")
  lastName   String   @map("last_name")
  country    String
  city       String
  segment    String   // 'consumer' | 'sme' | 'enterprise'
  createdAt  DateTime @default(now()) @map("created_at")

  orders     Order[]

  @@index([country])
  @@index([segment])
  @@map("customers")
}

model Product {
  id         String   @id @default(cuid())
  sku        String   @unique
  name       String
  category   String   // 'electronics' | 'apparel' | 'home' | 'books' | 'grocery'
  price      Decimal  @db.Decimal(12, 2)
  currency   String   @default("USD")
  createdAt  DateTime @default(now()) @map("created_at")

  orderItems OrderItem[]
  inventory  Inventory[]

  @@index([category])
  @@map("products")
}

model Warehouse {
  id        String @id @default(cuid())
  name      String
  country   String
  city      String

  inventory Inventory[]

  @@map("warehouses")
}

model Inventory {
  id              String    @id @default(cuid())
  productId       String    @map("product_id")
  warehouseId     String    @map("warehouse_id")
  quantityOnHand  Int       @map("quantity_on_hand")
  reorderLevel    Int       @default(20) @map("reorder_level")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([productId, warehouseId])
  @@index([productId])
  @@map("inventory")
}

model Employee {
  id          String    @id @default(cuid())
  firstName   String    @map("first_name")
  lastName    String    @map("last_name")
  department  String    // 'sales' | 'support' | 'engineering' | 'ops' | 'finance'
  role        String
  hiredAt     DateTime  @map("hired_at")
  salary      Decimal   @db.Decimal(12, 2)
  currency    String    @default("USD")

  orders Order[]

  @@index([department])
  @@map("employees")
}

model Order {
  id          String    @id @default(cuid())
  customerId  String    @map("customer_id")
  employeeId  String?   @map("employee_id")
  status      String    // 'pending' | 'paid' | 'shipped' | 'delivered' | 'cancelled' | 'refunded'
  total       Decimal   @db.Decimal(12, 2)
  currency    String    @default("USD")
  createdAt   DateTime  @default(now()) @map("created_at")
  deliveredAt DateTime? @map("delivered_at")

  customer   Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  employee   Employee?     @relation(fields: [employeeId], references: [id])
  items      OrderItem[]
  transactions Transaction[]

  @@index([customerId])
  @@index([employeeId])
  @@index([status])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id         String  @id @default(cuid())
  orderId    String  @map("order_id")
  productId  String  @map("product_id")
  quantity   Int
  unitPrice  Decimal @db.Decimal(12, 2) @map("unit_price")

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model Transaction {
  id          String    @id @default(cuid())
  orderId     String    @map("order_id")
  method      String    // 'card' | 'wallet' | 'bank_transfer' | 'cod'
  status      String    // 'succeeded' | 'failed' | 'refunded' | 'chargeback'
  amount      Decimal   @db.Decimal(12, 2)
  currency    String    @default("USD")
  processedAt DateTime  @default(now()) @map("processed_at")
  refundedAt  DateTime? @map("refunded_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([status])
  @@index([processedAt])
  @@map("transactions")
}

// ============================================================================
// Doc registry (source-of-truth for what we've ingested into Pinecone)
// ============================================================================

model Doc {
  id          String   @id @default(cuid())
  sourcePath  String   @map("source_path")
  docType     String   @map("doc_type") // 'policy' | 'manual' | 'faq' | 'other'
  sha256      String   @unique
  chunkCount  Int      @default(0) @map("chunk_count")
  tokens      Int      @default(0)
  ingestedAt  DateTime @default(now()) @map("ingested_at")
  meta        Json     @default("{}")

  @@index([docType])
  @@map("docs")
}
